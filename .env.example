# This app reads process.env directly (no dotenv loader), so this file is
# reference only — set these as real environment variables in your shell
# or in your host's dashboard (e.g. Render) rather than relying on this file.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me-too

# Optional. If set, live chats get AI-matched against the brand's broadcast
# library and the best match is surfaced in the tip banner automatically.
# Leave unset to disable the feature entirely (no error, just a no-op).
ANTHROPIC_API_KEY=
